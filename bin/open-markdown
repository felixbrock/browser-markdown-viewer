#!/usr/bin/env python3
"""Open a markdown file in the running browser window and bring that window up.

Used by the VS Code task open_markdown_in_browser, which passes the file and
the folder open in that VS Code window. The folder lands in the state file
(see mdv_common.state_path), so ctrl+shift+v in the browser can return to the
same VS Code window, or reopen the folder when the window is gone, see
bin/editor-host.

On Linux Brave receives the file url and opens it as a tab in its last active
window, the extension then swaps to an already open tab for the same file. i3
is configured with focus_on_window_activation urgent, so the window only gets
an urgency flag, this script follows that flag and focuses the window.

On macOS Google Chrome gets the url through open -a, which also brings Chrome
to the front, the extension swaps tabs the same way.
"""

import os
import shutil
import subprocess
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import mdv_common  # noqa E402

FOCUS_TIMEOUT_S = 1.5
MAC_BROWSER = "Google Chrome"


def is_brave(node):
    return mdv_common.window_class(node).startswith("brave")


def main():
    if len(sys.argv) < 2:
        print("usage: open-markdown <file> [<workspace folder>]", file=sys.stderr)
        return 2
    path = os.path.realpath(sys.argv[1])
    if not os.path.isfile(path):
        print(f"not a file, {path}", file=sys.stderr)
        return 1
    # The folder is kept as VS Code names it, VS Code matches its windows by
    # that path, a resolved symlink would not find the window again.
    folder = os.path.abspath(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2] else None
    if folder and os.path.isdir(folder):
        try:
            mdv_common.record_workspace(path, folder)
        except OSError as error:
            print(f"could not record the workspace folder, {error}", file=sys.stderr)
    url = "file://" + urllib.parse.quote(path)
    if mdv_common.MACOS:
        result = subprocess.run(["open", "-a", MAC_BROWSER, url], check=False)
        return result.returncode
    brave = shutil.which("brave") or "/opt/brave/brave"
    subprocess.Popen(
        [brave, url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    mdv_common.focus_window(is_brave, FOCUS_TIMEOUT_S)
    return 0


if __name__ == "__main__":
    sys.exit(main())
