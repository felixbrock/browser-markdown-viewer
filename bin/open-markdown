#!/usr/bin/env python3
"""Open a markdown file in the running Brave window and switch i3 to that window.

Used by the VS Code task open_markdown_in_browser. Brave receives the file url
and opens it as a tab in its last active window, the extension then swaps to an
already open tab for the same file. i3 is configured with
focus_on_window_activation urgent, so the window only gets an urgency flag,
this script follows that flag and focuses the window.
"""

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.parse

FOCUS_TIMEOUT_S = 1.5
POLL_S = 0.1


def is_brave(node):
    props = node.get("window_properties") or {}
    window_class = (props.get("class") or "").lower()
    return window_class.startswith("brave")


def find_windows(node, predicate, found):
    if node.get("window") is not None and predicate(node):
        found.append(node)
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        find_windows(child, predicate, found)
    return found


def i3_tree():
    result = subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, text=True, check=False)
    if result.returncode != 0 or not result.stdout:
        return None
    return json.loads(result.stdout)


def focus_brave_window():
    if not shutil.which("i3-msg"):
        return
    deadline = time.time() + FOCUS_TIMEOUT_S
    tree = None
    while time.time() < deadline:
        tree = i3_tree()
        if tree is None:
            return
        if find_windows(tree, lambda n: is_brave(n) and n.get("focused"), []):
            return
        urgent = find_windows(tree, lambda n: is_brave(n) and n.get("urgent"), [])
        if urgent:
            subprocess.run(["i3-msg", f"[con_id={urgent[0]['id']}] focus"], capture_output=True, check=False)
            return
        time.sleep(POLL_S)
    if tree is None:
        return
    any_brave = find_windows(tree, is_brave, [])
    if any_brave:
        subprocess.run(["i3-msg", f"[con_id={any_brave[0]['id']}] focus"], capture_output=True, check=False)


def main():
    if len(sys.argv) < 2:
        print("usage: open-markdown <file>", file=sys.stderr)
        return 2
    path = os.path.realpath(sys.argv[1])
    if not os.path.isfile(path):
        print(f"not a file, {path}", file=sys.stderr)
        return 1
    url = "file://" + urllib.parse.quote(path)
    brave = shutil.which("brave") or "/opt/brave/brave"
    subprocess.Popen(
        [brave, url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    focus_brave_window()
    return 0


if __name__ == "__main__":
    sys.exit(main())
